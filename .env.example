# ---------------------------------------------------------------------------
# Companion services for night_ai_scientist.
#   cp .env.example .env    then:  set -a; . ./.env; set +a
# ---------------------------------------------------------------------------

# === retrieval/ ============================================================
# Where the corpus and index live. Defaults put both under ./output.
# ARXIV_CORPUS=./output/arxiv_papers.jsonl
# ARXIV_INDEX_DIR=./output/arxiv_index
# RETRIEVER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Kaggle credentials, to download the arXiv metadata snapshot.
# KAGGLE_USERNAME=<your-kaggle-username>
# KAGGLE_KEY=<your-kaggle-key>

# === synthetic/ ============================================================
SYNTHETIC_PROPOSAL_AZURE_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
SYNTHETIC_PROPOSAL_AZURE_MODEL=gpt-4.1
# User-assigned managed identity that can reach the resource above.
CLIENT_ID=<your-managed-identity-client-id>
# SYNTHETIC_PROPOSAL_OUTPUT_FILE=./output/synthetic_grounded_proposals.jsonl
